    ]
  },
  "Enum": {
    "prefix": "se",
    "description": "Pure enum, PSR-4 namespace",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace ${1:__NS__};",
      "",
      "enum ${2:$TM_FILENAME_BASE}",
      "{",
      "\tcase ${3:Foo};",
      "\t$0",
      "}"
    ]
  },
  "Backed enum": {
    "prefix": "ses",
    "description": "Backed enum, PSR-4 namespace",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace ${1:__NS__};",
      "",
