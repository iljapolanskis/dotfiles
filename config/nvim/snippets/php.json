{
  "PHP file header": {
    "prefix": "sh",
    "description": "<?php + strict_types, no namespace",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "$0"
    ]
  },
  "Final class": {
    "prefix": "sc",
    "description": "Final class, PSR-4 namespace",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace ${1:__NS__};",
      "",
      "final class ${2:$TM_FILENAME_BASE}",
      "{",
      "\t$0",
      "}"
    ]
  },
  "Abstract class": {
    "prefix": "sac",
    "description": "Abstract class, PSR-4 namespace",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace ${1:__NS__};",
      "",
      "abstract class ${2:$TM_FILENAME_BASE}",
      "{",
      "\t$0",
      "}"
    ]
  },
  "Interface": {
    "prefix": "si",
