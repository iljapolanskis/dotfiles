      "{",
      "\tcase ${4:Foo} = '${5:foo}';",
      "\t$0",
      "}"
    ]
  },
  "PHPUnit test case": {
    "prefix": "su",
    "description": "PHPUnit TestCase, PSR-4 namespace",
    "body": [
      "<?php",
      "",
      "declare(strict_types=1);",
      "",
      "namespace ${1:__NS__};",
      "",
      "use PHPUnit\\\\Framework\\\\TestCase;",
      "",
      "final class ${2:$TM_FILENAME_BASE} extends TestCase",
      "{",
      "\tpublic function test${3:ItWorks}(): void",
      "\t{",
      "\t\t$0",
      "\t}",
      "}"
    ]
  },
  "Constructor": {
    "prefix": "sctor",
    "description": "Constructor with promoted property",
    "body": [
      "public function __construct(",
      "\tprivate readonly ${1:Type} \\$${2:name},",
      ") {",
      "}",
      "$0"
    ]
  },
  "Public method": {
    "prefix": "sm",
    "description": "Public method with return type",
    "body": [
      "public function ${1:name}(${2}): ${3:void}",
      "{",
      "\t$0",
      "}"
    ]
  }
