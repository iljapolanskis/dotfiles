# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=top height=40 blur_radius=30 color=0x40000000 topmost=window

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding AeroSpace Workspace Indicators #####
# Regular items (not space components) tied to AeroSpace named workspaces.
# The hidden `spaces` item repaints them on aerospace_workspace_change (fired
# from aerospace.toml).

# Register custom events so --trigger and --subscribe work
sketchybar --add event aerospace_workspace_change
sketchybar --add event window_focus_changed
sketchybar --add event input_change AppleSelectedInputSourcesChangedNotification

# One row per workspace: name, monitor side, icon. `left`/`right` are resolved
# to real sketchybar display ids just below.
#
# This was three parallel arrays indexed by the same `i`, kept in sync by eye,
# with hand-inserted spaces pretending to align columns that never actually
# lined up. Now a mismatch is impossible.
#  name     side   icon
WORKSPACES=(
  "cli      left   "  # nf-dev-terminal
  "code     left   "  # nf-fa-code
  "db       left   "  # nf-fa-database
  "api      left   󰌶"  # nf-md-api
  "misc     left   "  # nf-fa-th-large
  "chrome   right  "  # nf-fa-chrome
  "firefox  right  "  # nf-dev-firefox
  "notes    right  "  # nf-fa-book
  "email    right  "  # nf-fa-envelope
  "slack    right  "  # nf-mdi-slack
)

# `left`/`right` -> sketchybar `display=`.
#
# Two unrelated numberings, and on this machine they are INVERTED:
#
#   physical   x       aerospace monitor-id   sketchybar display=
#   left       -1920   1                      2
#   right          0   2                      1  (main)
#
# aerospace sorts monitors left to right. sketchybar takes the macOS
# *arrangement* index, which puts the main display first. So feeding the
# aerospace id straight into `display=` — what this config did — drew every
# workspace indicator on the opposite screen from its own workspace.
#
# aerospace reports both numbers, so derive the map instead of hardcoding it:
#   monitor-id                         position, left to right
#   monitor-appkit-nsscreen-screens-id macOS arrangement index = display=
# Cross-check any time with: sketchybar --query displays
#
# Here-doc, not a pipe: a `while read` in a pipeline runs in a subshell and
# the array would not survive it.
DISPLAYS_LTR=()
while IFS='|' read -r _ display_id; do
  [ -n "$display_id" ] && DISPLAYS_LTR+=("$display_id")
done <<EOF
$(aerospace list-monitors --format '%{monitor-id}|%{monitor-appkit-nsscreen-screens-id}' 2>/dev/null)
EOF

# One monitor: left and right collapse onto it, so no monitor-count branch.
# The emptiness check is load-bearing: sketchybar can start before AeroSpace is
# up, and bash 3.2 (what /bin/sh is here, and what sketchybar execs this with)
# errors on a negative array subscript rather than returning empty.
DISPLAY_LEFT=1
DISPLAY_RIGHT=1
if [ "${#DISPLAYS_LTR[@]}" -gt 0 ]; then
  DISPLAY_LEFT="${DISPLAYS_LTR[0]}"
  DISPLAY_RIGHT="${DISPLAYS_LTR[$(( ${#DISPLAYS_LTR[@]} - 1 ))]}"
fi

for row in "${WORKSPACES[@]}"
do
  read -r ws side icon <<< "$row"
  case "$side" in
    left)  DISPLAY_MON="$DISPLAY_LEFT"  ;;
    right) DISPLAY_MON="$DISPLAY_RIGHT" ;;
    *)     DISPLAY_MON="$side"          ;;  # a literal display index still works
  esac
  space=(
    display="$DISPLAY_MON"
    icon="$icon"
    icon.padding_left=7
    icon.padding_right=7
    label="$ws"
    label.drawing=off
    label.font="Hack Nerd Font:Bold:11.0"
    label.padding_left=0
    label.padding_right=7
    background.color=0x60ffffff
    background.corner_radius=5
    background.height=25
    background.drawing=off
    click_script="aerospace workspace $ws"
  )
  sketchybar --add item space."$ws" left \
             --set space."$ws" "${space[@]}"
  WS_NAMES="$WS_NAMES $ws"
done

# One hidden controller repaints every indicator per event, instead of each
# item running its own script: far fewer execs per switch (see spaces.sh).
sketchybar --add item spaces left \
           --set spaces drawing=off script="$PLUGIN_DIR/spaces.sh$WS_NAMES" \
           --subscribe spaces aerospace_workspace_change system_woke

##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off \
           --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched \
           --add item window_count left \
           --set window_count \
               update_freq=0 \
               label.font="Hack Nerd Font:Bold:13.0" \
               label.color=0xffffffff \
               background.drawing=off \
               drawing=off \
               script="$PLUGIN_DIR/window_count.sh" \
           --subscribe window_count \
               window_focus_changed \
               aerospace_workspace_change \
               front_app_switched

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=10 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item input right \
           --set input icon=󰌌 script="$PLUGIN_DIR/input.sh" \
           --subscribe input input_change \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
